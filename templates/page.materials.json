    "670886a7-d1e2-4ad8-ab2b-62b17ec085eb": {
      "type": "text-with-image-new",
      "blocks": {
        "template--14616109908081__670886a7-d1e2-4ad8-ab2b-62b17ec085eb-168596294370135038-0": {
          "type": "heading",
          "settings": {
            "heading": "Luxury Fashion Made from the Softest Fibers On Earth",
            "heading_size": "h1"
          }
        },
        "template--14616109908081__670886a7-d1e2-4ad8-ab2b-62b17ec085eb-168596294370135038-1": {
          "type": "text",
          "settings": {
            "text": "<p>Tencel™ Modal Fibers are derived from sustainably sourced renewable raw wood materials and produced by environmentally responsible processes. Tencel™ branded cellulosic fibers define a new standard of sustainability and natural comfort.<\/p>",
            "text_style": "body"
          }
        },
