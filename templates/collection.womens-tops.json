    "faq_new_VxmFhr": {
      "type": "faq-new",
      "blocks": {
        "text_block_VnXbqF": {
          "type": "text_block",
          "settings": {
            "question": "What fabric are Bleusalt tops made from?",
            "answer": "<p>All Bleusalt tops are made from our signature beechwood fiber, a breathable, biodegradable, and ultra-soft material derived from sustainably harvested trees. It’s vegan, hypoallergenic, and naturally moisture-wicking.</p>"
          }
        },
        "text_block_RRxJpB": {
          "type": "text_block",
          "settings": {
            "question": "Are Bleusalt tops sustainably made?",
            "answer": "<p>Yes! Every piece is crafted using eco-friendly materials in a zero-waste, ethical production process. All garments are made locally in Malibu, California, supporting U.S.-based manufacturing and reducing our carbon footprint.</p>"
          }
        },
        "text_block_QEXTtJ": {
          "type": "text_block",
          "settings": {
            "question": "How do Bleusalt tops feel compared to cotton?",
            "answer": "<p>Our beechwood modal is softer than cotton and more breathable. It drapes beautifully, resists pilling, and holds its shape over time, making it ideal for both casual and elevated looks.</p>"
          }
        },
        "text_block_8Mx6Lm": {
          "type": "text_block",
          "settings": {
            "question": "Do Bleusalt tops work for travel or work-from-home wear?",
            "answer": "<p>Absolutely. Our tops are designed for everyday versatility. They're wrinkle-resistant, breathable, and luxuriously soft, perfect for long flights, cozy days at home, or pairing with tailored pieces for a polished look.</p>"
          }
        },
        "text_block_yj6KE3": {
          "type": "text_block",
          "settings": {
            "question": "How should I care for my Bleusalt tops?",
            "answer": "<p>The machine washes cold with colors and lays flat or hangs to dry. Avoid high heat or harsh detergents to preserve the softness and longevity of the fabric.</p>"
          }
        },
        "text_block_4ggByE": {
          "type": "text_block",
          "settings": {
            "question": "What sizes do Bleusalt women’s tops come in?",
            "answer": "<p>Bleusalt women’s tops are available in sizes 00 through 6, which correspond to XXS through 2X. Here's a quick breakdown of how Bleusalt sizing compares to international standards:</p><ul><li><strong>00 = XXS</strong> (US 30, UK 30, EU/IT/RU 40)<br/><br/></li><li><strong>0 = XS</strong> (US 32, UK 32, EU/IT/RU 42)<br/><br/></li><li><strong>1 = S</strong> (US 34, UK 34, EU/IT/RU 44)<br/><br/></li><li><strong>2 = M</strong> (US 36–38, UK 36–38, EU/IT/RU 46–48)<br/><br/></li><li><strong>3 = L</strong> (US 40, UK 40, EU/IT/RU 50)<br/><br/></li><li><strong>4 = XL</strong> (US 42–44, UK 42–44, EU/IT/RU 52–54)<br/><br/></li><li><strong>5 = 1X</strong> (US 46, UK 46, EU/IT/RU 56)<br/><br/></li><li><strong>6 = 2X</strong> (US 48, UK 48, EU/IT/RU 58)</li></ul><p></p><p>For detailed measurements and fit suggestions, please refer to our full-<a href=\"https://bleusalt.com/pages/bleusalt-size-chart-sizing-guide\"><span style=\"text-decoration:underline\">size chart</span></a>.<br/><br/></p>"
          }
        },
        "text_block_V8CnNA": {
          "type": "text_block",
          "settings": {
            "question": "Is Bleusalt suitable for a capsule wardrobe?",
            "answer": "<p>Yes! Our seasonless designs and neutral tones make Bleusalt perfect for building a minimalist, capsule-style wardrobe. Each piece is intentionally created to mix, match, and layer with ease.</p>"
          }
        }
      },
