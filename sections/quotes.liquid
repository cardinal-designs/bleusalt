{% render 'render-css', filename: 'section-testimonials.css', local: true %}

<style>
  [data-section-id="{{ section.id }}"] .quote-block + .quote-block {
    margin-top: {{ section.settings.padding_top | divided_by: 2 }}px;
  }
</style>

<div>
    <div data-section-id="{{ section.id }}" data-section-type="quotes" class="{% unless section.settings.full_width %}page-width small--page-width{% endunless %}{% if section.settings.hide_mobile %} small--hide{% endif %}{% if section.settings.hide_desktop %} medium-up--hide{% endif %}" style="text-align: {{ section.settings.text_align }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
      {% if section.settings.title != blank %}
      <div class="section-header text-center">
        <h2 class="h1">{{ section.settings.title | escape }}</h2>
      </div>
      {% endif %}
      
      {%- liquid 
        assign customer_items = ''
        assign press = '' 
      %}
      
      {% for block in section.blocks %}
          {% if block.type == 'quote' %}
              {% capture customer_items %}{{ customer_items }}
              <div class="swiper-slide">
                <div class="quote quote-customer center">
                    <div class="quote-customer__stars">
                    <h2>5 Stars</h2>
                    {% render 'icon-five-stars' %}
                    </div>
                    <div class="rte quote-text">{{ block.settings.quote }}</div>
                    {% if block.settings.author != blank %}
                    <cite>{{ block.settings.author | escape }}</cite>
                    {% endif %}
                </div>
              </div>
              {% endcapture %}
          {% elsif block.type =='quote_press' %}
              {% capture press %}{{ press }}
              <div class="swiper-slide">
                <div class="quote quote-press text-center">
                    {% if block.settings.logo != blank %}
                    <div class="quote-press__logo" data-bg="{{ block.settings.logo | image_url: height: 65 }}">
                        <span class="visually-hidden">Logo for {{ block.settings.author }}</span>
                    </div>
                    {% endif %}
                    {% if block.settings.quote != blank %}
                    <div class="rte quote-text">{{ block.settings.quote }}</div>
                    {% endif %}
                </div>
              </div>
              {% endcapture %}
          {% endif %}
      {% endfor %}
      
      {%- capture slick_settings_press -%}
      {
          "slidesPerView":1,
          "autoplay":true,
          "loop":true,
          "effect":"fade",
          "fadeEffect": {
            "crossFade":true
          }
      }
      {%- endcapture -%}
      
      {%- capture slick_settings_customer -%}
      {
        "slidesPerView":1,
        "autoplay":true,
        "loop":true,
        "effect":"fade",
        "fadeEffect": {
            "crossFade":true
        }
      }
      {%- endcapture -%}
      
     
      <div>
        {% if press != '' %}
        <div class="relative quote-block" >
          <div class="quotes-wrapper quotes-wrapper-1" style="background-color: {{ section.settings.color_background }};">
            <div class="quotes-slider swiper" data-json='{{- slick_settings_press -}}'>
                <div class="swiper-wrapper">
                  {{ press }}
                </div>
            </div>
            <div class="quotes-slider__links right">
              <h4>
                <a href="{{ section.settings.press_link }}" class="link">
                    <u>Have you heard?</u>
                </a>
              </h4>
              
              <button class="quotes-slider__prev btn--link press-slider__prev">
                {% render 'icon-caret' %}
                <span class="visually-hidden">Previous Press Quote</span>
              </button>
              <button class="quotes-slider__next btn--link press-slider__next">
                {% render 'icon-caret' %}
                <span class="visually-hidden">Next Press Quote</span>
              </button>
            </div>
          </div>
        </div>
        {% endif %}
        {% if customer_items != '' %}
        <div class="relative quote-block">
          <div class="quotes-wrapper quotes-wrapper-2" style="background-color: {{ section.settings.color_background }};">
            <div class="quotes-slider swiper" data-json='{{- slick_settings_customer -}}'>
                <div class="swiper-wrapper">
                  {{ customer_items }}
                </div>
            </div>
            <div class="quotes-slider__links right">
              <h4>
                <a href="{{ section.settings.reviews_link }}" class="link">
                    <u>Customer Reviews</u>
                </a>
              </h4>
              <button class="quotes-slider__prev btn--link customer-slider__prev">
                {% render 'icon-caret' %}
                <span class="visually-hidden">Previous Customer Quote</span>
              </button>
              <button class="quotes-slider__next btn--link customer-slider__next">
                {% render 'icon-caret' %}
                <span class="visually-hidden">Next Customer Quote</span>
              </button>
            </div>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

