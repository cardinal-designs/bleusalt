{% render 'hs-defer-css' with filename: 'alt-article-content.css', pages: 'collection,index,product' | split: ',', local: true %}

<div class="alt__article--content">
    <div class="article-container">
        {% if section.settings.title != blank %}
            <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.sub_text != blank %}
            <div class="article-rte">{{ section.settings.sub_text }}</div>
        {% endif %}

        <div class="outfit-formula">
            <h3>With Your Three Bleusalt Pieces</h3>
            <ul class="outfit-list">
                <li>Cindy Pant + Classic Crew + sneakers</li>
                <li>Cindy Pant + Classic Crew + Wrap at waist + sneakers</li>
                <li>Cindy Pant + Classic Crew + Wrap as cardigan + flats</li>
                <li>Cindy Pant + Wrap as top + heels</li>
            </ul>
            <h3 style="margin-top: 50px;">With What You Already Own</h3>
            <ul class="outfit-list">
                <li>Your jeans + Classic Crew + Wrap over shoulders + flats</li>
                <li>Your jeans + Classic Crew + Wrap at waist + boots</li>
                <li>Your jeans + Wrap as top + sneakers</li>
                <li>Your jeans + your tank + Wrap as cardigan + sandals</li>
                <li>Your dress + Wrap as cardigan + flats</li>
                <li>Your trousers + Classic Crew + Wrap as scarf + heels</li>
                <li>Your skirt + Classic Crew tucked + Wrap at waist + boots</li>
                <li>Your pants + Wrap as top + your blazer + heels</li>
            </ul>
        </div>

        {% if section.settings.top_quote_title != blank %}
            <div class="pullquote">{{ section.settings.top_quote_title }}</div>
        {% endif %}
        {% if section.settings.image != blank %}
            <div class="article-image-full">
                {%- render 'image',
                image: section.settings.image,
                sizes: '(min-width: 768px) 50vw, 100vw',
                prioritize_loading: true
                -%}
            </div>
            {% if section.settings.image_caption != blank %}
            <div class="image-caption">{{ section.settings.image_caption }}</div>
            {% endif %}
        {% endif %}
        {% if section.settings.bottom_title != blank %}
            <h2>{{ section.settings.bottom_title }}</h2>
        {% endif %}
        {% if section.settings.bottom_sub_title != blank %}
            <h3>{{ section.settings.bottom_sub_title }}</h3>
        {% endif %}
        {% if section.settings.bottom_conetnt != blank %}
            <div class="article-rte">{{ section.settings.bottom_conetnt }}</div>
        {% endif %}
        {% if section.settings.bottom_quote_title != blank %}
            <div class="pullquote">{{ section.settings.bottom_quote_title }}</div>
        {% endif %}
        {% if section.settings.bottom_quote_conetnt != blank %}
            <div class="article-rte">{{ section.settings.bottom_quote_conetnt }}</div>
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "Article Outfit Formula",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "richtext",
            "id": "sub_text",
            "label": "Sub text"
        },
        {
            "type": "text",
            "id": "outfit_formula_title_1",
            "label": "Outfit Formula Title 1"
        },
        {
            "type": "richtext",
            "id": "outfit_formula_list_1",
            "label": "Outfit Formula List 1"
        },
        {
            "type": "text",
            "id": "outfit_formula_title_2",
            "label": "Outfit Formula Title 2"
        },
        {
            "type": "richtext",
            "id": "outfit_formula_list_2",
            "label": "Outfit Formula List 2"
        },

        {
            "type": "text",
            "id": "top_quote_title",
            "label": "Top quote title"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_caption",
            "label": "Image caption"
        },
        {
            "type": "text",
            "id": "bottom_title",
            "label": "Bottom sub title"
        },
        {
            "type": "text",
            "id": "bottom_sub_title",
            "label": "Bottom title"
        },        
        {
            "type": "richtext",
            "id": "bottom_conetnt",
            "label": "Bottom content"
        },
        {
            "type": "text",
            "id": "bottom_quote_title",
            "label": "Bottom quote title"
        },
        {
            "type": "richtext",
            "id": "bottom_quote_conetnt",
            "label": "Bottom quote content"
        }
    ],
    "presets": [
        {
            "name": "Article Outfit Formula"
        }
    ]
}
{% endschema %}