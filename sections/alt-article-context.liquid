{% render 'hs-defer-css' with filename: 'alt-article-content.css', pages: 'collection,index,product' | split: ',', local: true %}

<div class="alt__article--content">
    <div class="article-container">
        {% if section.settings.title != blank or section.settings.content != blank or section.settings.sub_text != blank %}
            <div class="context-section">
                {% if section.settings.title != blank %}
                    <h3>{{ section.settings.title }}</h3>
                {% endif %}
                {% if section.settings.content != blank %}
                    <div class="article-rte">{{ section.settings.content }}</div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "Article Finale",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
    ],
    "presets": [
        {
            "name": "Article Finale"
        }
    ]
}
{% endschema %}