{% render 'hs-defer-css' with filename: 'alt-article-content.css', pages: 'collection,index,product' | split: ',', local: true %}


{% assign metafield_full = section.settings.metafield_key %}

{% assign metafield_parts = metafield_full | split: '.' %}
{% assign namespace = metafield_parts[0] %}
{% assign key = metafield_parts[1] %}

{% assign context = article.metafields[namespace][key].value %}

context -- {{ context }}

<div class="alt__article--content">
    <div class="article-container">
        {% for data in context %}
            {% if data.title != blank or data.content != blank %}
                <div class="context-section">
                    {% if data.title != blank %}
                        <h3>{{ data.title }}</h3>
                    {% endif %}
                    {% if data.content != blank %}
                        <div class="article-rte">{{ data.content | metafield_tag }}</div>
                    {% endif %}
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

{% schema %}
{
    "name": "Article Context",
    "settings": [
        {
            "type": "textarea",
            "id": "metafield_key",
            "label": "Metafield key"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
    ],
    "presets": [
        {
            "name": "Article Context"
        }
    ]
}
{% endschema %}