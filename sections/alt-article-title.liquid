{% render 'hs-defer-css' with filename: 'alt-article-title.css', pages: 'collection,index,product' | split: ',', local: true %}

<div class="alt__article--title">
    <div class="article-container">
        <div class="category-label">Fashion / Style Intelligence</div>
        <h1>{{ article.title }}</h1>
        <div class="subtitle">Building Your Bleusalt Foundation</div>
        <div class="byline">By Lyndie Irons for Bleusalt</div>
    </div>
</div>

{% schema %}
{
    "name": "Article Title Section",
    "settings": [
        {
            "type": "text",
            "id": "category",
            "label": "Category"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Sub title"
        },
        {
            "type": "text",
            "id": "byline",
            "label": "By line"
        }
    ]
}
{% endschema %}