{% render 'hs-defer-css' with filename: 'template-collection.css', pages: 'collection,index,product' | split: ',', local: true %}
{% render 'hs-defer-css' with filename: 'component-loading-overlay.css', pages: 'collection,index,product' | split: ',', local: true %}
{% render 'hs-defer-css' with filename: 'component-card.css', pages: 'collection,index,product' | split: ',', local: true %}
{% render 'hs-defer-css' with filename: 'component-price.css', pages: 'collection,index,product' | split: ',', local: true %}
{% render 'hs-defer-css' with filename: 'component-ns-skeleton-loader.css', pages: 'collection,index,product' | split: ',', local: true %}

{%- if section.settings.enable_quick_add -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <script defer src="{{ 'quick-add.min.js' | asset_url }}"></script>
  <script defer src="{{ 'product-form.js' | asset_url }}"></script>
{%- endif -%}
<noscript>{% render 'hs-defer-css' with filename: 'component-rte.css', pages: 'collection,index,product' | split: ',', local: true %}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0px;
    /* padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; */
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid 
  assign products_per_page = section.settings.products_per_page
  for block in section.blocks
    if block.type == 'marketing_tile'
      assign tile_value = block.settings.tile_size | remove: 'x' | plus: 0
      assign products_per_page = products_per_page | minus: tile_value
    endif
  endfor
-%}

<div class="section-{{ section.id }}-padding">
  <div class="">
    <div class="product-grid-container" id="ProductGridContainer">
      <div class="ns-skeleton-wrap page-width">
        <div class="ns-skeleton-toolbar color-background-2"></div>
        <div class="ns-skeleton-grid grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
          grid--{{ section.settings.columns_desktop }}-col-desktop">
          {%- paginate collection.products by products_per_page -%}
            {%- for product in collection.products -%}
              <div class="ns-skel-product grid__item">
                <div class="ns-skel-img color-background-2"></div>
                <div class="ns-skel-details">
                  <div class="ns-skel-prodtitle"></div>
                  <div class="ns-skel-price color-background-2"></div>
                  <div class="ns-skel-color color-background-2"></div>
                  <div class="ns-skel-swatches color-background-2"></div>
                  <div class="ns-skel-reviews color-background-2"></div>
                </div>
              </div>
            {%- endfor -%}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% if template.suffix == 'try-before-you-buy' %}
  <script>
    async function switchToTryNow(){
      let tryLink = await window.trynow.hasPassedTryLink();
        if(tryLink){
            const buttons = document.querySelectorAll('.quick-add__add-button.button--inline');
            buttons.forEach((button) => {
              button.textContent = 'Try Before You Buy';
          })
        }
    }

document.addEventListener("DOMContentLoaded", (event) => {
    switchToTryNow()
  })

  
  </script>
{% endif %}


{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 3,
      "max": 60,
      "step": 3,
      "default": 15,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_life_image",
      "default": true,
      "label": "Show life image as main image"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.enable_quick_buy.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "marketing_tile",
      "name": "Marketing Tile",
      "settings": [
        {
          "type": "select",
          "id": "tile_size",
          "default": "1x",
          "label": "Tile size",
          "options": [
            {
              "value": "1x",
              "label": "1x"
            },
            {
              "value": "2x",
              "label": "2x"
            }
          ]
        },
        {
          "type": "select",
          "id": "media_type",
          "default": "image",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": ".mp4 file in Settings > Files"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "position",
          "min": 0,
          "max": 24,
          "step": 1,
          "label": "Position",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "paragraph",
          "label": "Paragraph"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        }
      ]
    }
  ]
}
{% endschema %}