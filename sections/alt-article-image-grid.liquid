{% render 'hs-defer-css' with filename: 'alt-article-content.css', pages: 'collection,index,product' | split: ',', local: true %}

{% assign image_meta = article.metafields.custom.image_grid.value %}

{% if image_meta != blank %}
    <div class="alt__article--content">
        <div class="article-container">
            <div class="image-grid">
                {% for image in image_meta.images.value %}
                <div class="image-grid-item">
                    {%- render 'image',
                    image: image,
                    sizes: '(min-width: 768px) 50vw, 100vw',
                    prioritize_loading: true
                    -%}
                </div>
                {% endfor %}            
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
    "name": "Article Image Grid",
    "presets": [
        {
            "name": "Article Image Grid"
        }
    ]
}
{% endschema %}