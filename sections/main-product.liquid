<script>
  window.addEventListener('DOMContentLoaded', () => {
    const messageBlock = document.querySelector('.product-discount__message');
   
    if (messageBlock){
      messageBlock.addEventListener('click', (event) => {
        event.stopPropagation();
        messageBlock.classList.toggle('active');
      });
      document.addEventListener('click', (event) => {
        if (!messageBlock.contains(event.target) || !event.target.closest('.product-discount-over')) {
          messageBlock.classList.remove('active');
        }
      });
    }
  })
</script>

