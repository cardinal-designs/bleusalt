{% comment %}theme-check-disable TemplateLength, LiquidTag{% endcomment %}
{%- if product.metafields.inventory.ShappifyHidden == 'true' -%}{%- break -%}{%- endif -%}
<section id="MainProduct-{{ section.id }}" class="product__main page-width small-full-width section-{{ section.id }}-padding" data-section="{{ section.id }}">

  {{ 'section-main-product.css' | asset_url | stylesheet_tag: preload: true }}

  {% render 'hs-defer-css' with filename: 'section-main-product.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-accordion.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-price.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-rte.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-slider.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-rating.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-loading-overlay.css', pages: 'collection,index,product' | split: ',', local: true %}
  {% render 'hs-defer-css' with filename: 'component-deferred-media.css', pages: 'collection,index,product' | split: ',', local: true %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% if product.options.size > 1 %}
    {% style %}
      .product-form__submit[data-join-list] {
        display: block !important;
      }
    {% endstyle %}
  {% endif %}

{% assign sizing_popups = 'Sizing Guide,Measuring Guide' | split: ',' %}

  <script defer src="{{ 'product-form.js' | asset_url }}"></script>

{%- capture swiper_options -%}
{ 
  "loop": false,
  "slidesPerView": 1,
  "navigation": {
    "nextEl": ".product__media-list .swiper-button-next",
    "prevEl": ".product__media-list .swiper-button-prev"
  },
  "scrollbar": {
    "el": ".swiper-scrollbar",
    "hide": false,
    "draggable": true
  }
}
{%- endcapture -%}

{%- liquid 
    for option in product.options_with_values
      if option.name == "Color"
        assign selected_color = option.selected_value
      endif
      if option.name == "Size"
        assign selected_size = option.selected_value
      endif
    endfor
    for tag in product.tags 
      if tag == 'women'
        assign gender = tag
      endif
      if tag == 'men'
        assign gender = tag
      endif
    endfor

    assign first_tab = true
  -%}

  {%- assign first_3d_model = product.media | where: "media_type", "model" | first -%}
  {%- if first_3d_model -%}
    {% render 'hs-defer-css' with filename: 'component-product-model.css', pages: 'collection,index,product' | split: ',', local: true %}
    <link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
    <link id="ModelViewerOverride" rel="stylesheet" href="{{ 'component-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}

  {% if section.settings.show_breadcrumb %}
    {% render 'breadcrumb', product: product %}
  {% endif %}
  <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.gallery_layout }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
    <div class="grid__item product__media-wrapper">
      <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
        {{ "accessibility.skip_to_product_info" | t }}
      </a>
      
      {%- comment -%} Images {%- endcomment -%}
      <div 
        id="MediaGallery-{{ section.id }}"
        role="region" 
        {% if section.settings.enable_sticky_info %}
          class="product__media-gallery"
        {% endif %} 
        aria-label="{{ 'products.product.media.gallery_viewer' | t }}" 
        data-desktop-layout="{{ section.settings.gallery_layout }}"
      >
        <div id="GalleryViewer-{{ section.id }}" class="product-main-images">
          <div id="Slider-Gallery-{{ section.id }}" class="product__media-list contains-media swiper" data-json='{{- swiper_options -}}'
        >
          {%- comment -%} Mobile Images Slider {%- endcomment -%}
          <div class="product__gallery swiper-wrapper medium-up-hide">
            {%- liquid
              assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
              assign media_count = product.media.size
              if section.settings.hide_variants and media_count > 1
                assign media_count = media_count | minus: variant_images.size | plus: 1
              endif
            -%}
            {%- for media in product.media -%}
              {%- assign media_parts = media.alt | split: ' | ' -%}

              {%- if media_parts.size == 3 -%}
                {%- assign media_color = media_parts[0] | strip -%}
                {%- assign media_size  = media_parts[1] | strip -%}
              {%- elsif media_parts.size == 2 -%}
                {%- assign media_color = media_parts[0] | strip -%}
                {%- assign media_size  = "" -%}
              {%- endif -%}

              {%- assign has_color_option = false -%}
              {%- assign has_size_option  = false -%}
              
              {%- if product.options_by_name['Color'] -%}
                {%- assign has_color_option = true -%}
              {%- endif -%}
              
              {%- if product.options_by_name['Size'] -%}
                {%- assign has_size_option = true -%}
              {%- endif -%}
              
              {%- assign hide_image = false -%}
              
              {%- if has_color_option and has_size_option -%}
                {%- if media_color != selected_color and media_size != selected_size -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- elsif has_color_option and has_size_option == false -%}
                {%- if media_color != selected_color -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- elsif has_color_option == false and has_size_option -%}
                {%- if media_size != selected_size -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}
                <div 
                  class="swiper-slide product__main-image {% if section.settings.enable_zoom %}product__image--zoom{% endif %} product-media-item {% if media.media_type == 'video' and media.alt contains 'All' %}is-video{% endif %} {% if media.alt contains 'All' %}is-all{% endif %}{% if variant_images contains media.src %} pdp-first-image{% endif %}" 
                  data-filter="{{ media_color  }}"
                  data-size="{{ media_size }}"
                  {% if hide_image %} style="display: none;" {% endif %} 
                  {% if section.settings.enable_zoom %}
                    data-bg="{{ media.preview_image | image_url: width: 2000 }}"
                  {% endif %}
                >
                  {% case media.media_type %}
                    {% when 'image' %}
                      {%- liquid
                      assign prioritize_loading = false
                      if hide_image == false
                        assign prioritize_loading = true
                      endif
                    -%}
                    {% render 'new-image-element', image: media.preview_image, prioritize_loading: prioritize_loading %}
                  {% when 'video'%}
                      {% assign ratio =  1 | divided_by: media.preview_image.aspect_ratio | times: 100 %}
                      <div class="media" style="padding-top:{{ ratio }}%;">
                        {{ media | video_tag: autoplay: true, playsinline: true, loop: true, autoplay: true, muted: true, controls: false }}
                      </div>
                  {% endcase %}
                </div>
            {%- endfor -%}
          </div>
          
          {%- comment -%} Desktop Images (no slider) {%- endcomment -%}
          <div class="product__gallery small-hide">
            {%- for media in product.media -%}
              {%- assign media_parts = media.alt | split: ' | ' -%}

              {%- if media_parts.size == 3 -%}
                {%- assign media_color = media_parts[0] | strip -%}
                {%- assign media_size  = media_parts[1] | strip -%}
              {%- elsif media_parts.size == 2 -%}
                {%- assign media_color = media_parts[0] | strip -%}
                {%- assign media_size  = "" -%}
              {%- endif -%}

              {%- assign has_color_option = false -%}
              {%- assign has_size_option  = false -%}
              
              {%- if product.options_by_name['Color'] -%}
                {%- assign has_color_option = true -%}
              {%- endif -%}
              
              {%- if product.options_by_name['Size'] -%}
                {%- assign has_size_option = true -%}
              {%- endif -%}
              
              {%- assign hide_image = false -%}
              
              {%- if has_color_option and has_size_option -%}
                {%- if media_color != selected_color and media_size != selected_size -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- elsif has_color_option and has_size_option == false -%}
                {%- if media_color != selected_color -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- elsif has_color_option == false and has_size_option -%}
                {%- if media_size != selected_size -%}
                  {%- assign hide_image = true -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}

              <div 
                class="product__main-image {% if section.settings.enable_zoom and media.media_type != 'video' %}product__image--zoom{% endif %} product-media-item {% if media.media_type == 'video' and media.alt contains 'All' %}is-video{% endif %} {% if media.alt contains 'All' %}is-all{% endif %}{% if variant_images contains media.src %} pdp-first-image{% endif %}" 
                data-filter="{{ media_color }}" data-size="{{ media_size }}"
                {% if hide_image %} style="display: none;" {% endif %} 
                {% if section.settings.enable_zoom and media.media_type != 'video' %}
                  data-bg="{{ media.preview_image | image_url: width: 2000 }}"
                {% endif %}
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {%- liquid
                      assign prioritize_loading = false
                      if hide_image == false
                        assign prioritize_loading = true
                      endif
                    -%}
                    {% render 'new-image-element', image: media.preview_image, prioritize_loading: prioritize_loading %}
                  {% when 'video' %}
                    {% assign ratio = 1 | divided_by: media.preview_image.aspect_ratio | times: 100 %}
                    <div class="media" style="padding-top:{{ ratio }}%;">
                      {{ media | video_tag: autoplay: true, playsinline: true, loop: true, autoplay: true, muted: true, controls: false }}
                    </div>
                {% endcase %}
              </div>
            {%- endfor -%}
          </div>

          <div class="swiper-pagination medium-up-hide"></div>
          <div class="swiper-button-prev medium-up-hide"></div>
          <div class="swiper-button-next medium-up-hide"></div>
          <div class="swiper-scrollbar medium-up-hide"></div>

        </div>
        {%- if first_3d_model -%}
          <button
            class="button button--full-width product__xr-button"
            type="button"
            aria-label="{{ 'products.product.xr_button_label' | t }}"
            data-shopify-xr
            data-shopify-model3d-id="{{ first_3d_model.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden
          >
            {% render 'icon-3d-model' %}
            {{ 'products.product.xr_button' | t }}
          </button>
        {%- endif -%}
        </div>
      </div>

    </div>
    {%- assign product_form_id = 'product-form-' | append: section.id -%}
    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}">
      <div id="ProductInfo-{{ section.id }}" class="product__info-container small-page-width small-text-center{% if section.settings.enable_sticky_info %} product__info-container--sticky{% endif %}">    
       {% assign badges = '' %}
       {% for tag in product.tags %}
         {% if tag contains 'badge:' %}
           {% if badges == '' %}
             {% assign badges = tag | split: ':' | last %}
           {% else %}
             {% assign badges = badges | append: ',' | append: tag | split: ':' | last %}
           {% endif %}
         {% endif %}
       {% endfor %}
        <div class="pdp__badge">
          {%- if product.available == false -%}
            {%- if settings.show_sold_out -%}
              <span id="Badge-{{ section_id }}-{{ product.id }}" class="badge badge--sold-out color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
            {%- endif -%}
          {%- elsif product.compare_at_price > product.price and product.available -%}
            <span id="Badge-{{ section_id }}-{{ product.id }}" class="badge badge--sale color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
          {%- endif -%}
          {%- if badges != '' -%}
            {%- for badge in badges -%}
              <span id="Badge-{{ section_id }}-{{ product.id }}--{{ badge | handle }}" class="badge badge--{{ badge | handle }}">{{ badge }}</span>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'text' -%}
            {% assign text_split = block.settings.text | split: ' ' %}
            {% assign text_identifier = text_split[0] | append: text_split[1] | handle %}

            <p class="product__text product__text--{{ text_identifier }}{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}" {{ block.shopify_attributes }}>
              {%- liquid
                if product.metafields.custom.sub_atc_text != blank
                  assign text = product.metafields.custom.sub_atc_text.value
                elsif text_identifier == 'shippingcalculated' 
                  assign text = block.settings.text | replace: 'Shipping','<a class="link" href="/pages/shipping">Shipping</a>'
                else
                  assign text = block.settings.text | escape
                endif 
                echo text
              -%}
            </p>
          {%- when 'title' -%}
            <div class="product__title--price">
              <div class="product__title" {{ block.shopify_attributes }}>
                <h1 class="h2">{{ product.title | escape }}</h1>
              {% if product.metafields.custom.breadcrumb_collection != blank %}
                <a class="product-collection-link" href="/collections/{{ product.metafields.custom.breadcrumb_collection.value.handle }}">
                 <p>{{ product.metafields.custom.breadcrumb_collection.value.title }}</p>
                </a>
              {% endif %}
              </div>
              {% assign vendor_handle = product.vendor | handleize %}
              {% unless vendor_handle == 'couture' %}
              <div class="no-js-hidden product__price-wrapper" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large' -%}
              </div>
              {% endunless %}
            </div>
          {%- when 'price' -%}
            <div class="no-js-hidden product__price-wrapper" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
              {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
            </div>
            {% comment %}
            <div {{ block.shopify_attributes }}>
              {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
              {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large no_bold_options ' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>
            {% endcomment %}
          {%- when 'payment_plans' %}
            <div class="payment-plan">
              or 4 installments of fff<span class="payment-plan__amount">{{ product.selected_or_first_available_variant.price | divided_by: 4 | money_without_trailing_zeros }}</span> using ShopPay Installments
            </div>
            {% comment %}
              {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                <div class="product__tax caption rte">
                  {%- if shop.taxes_included -%}
                    {{ 'products.product.include_taxes' | t }}
                  {%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {% endcomment %}
            
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte quick-add-hidden">
                {{ product.description }}
              </div>
            {%- endif -%}
          {%- when 'custom_liquid' -%}
            {{ block.settings.custom_liquid }}
          {%- when 'collapsible_tab' -%}
            {%- liquid 
              if block.settings.use_product_description
                assign content = product.description | split: block.settings.product_description_split_value
                assign content = content[block.settings.product_description_index]
              endif 
            -%}
            {% if block.settings.content != blank or block.settings.page.content != blank or content != blank %}
              <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                <details id="Details-{{ block.id }}-{{ section.id }}" {% if first_tab %}open{% endif %}>
                  <summary>
                    <div class="summary__title">
                      <h2 class="h4 accordion__title">
                        {{ block.settings.heading | default: block.settings.page.title }}
                      </h2>
                    </div>
                    {% render 'icon-caret' %}
                  </summary>
                  <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                  {% if block.settings.heading == 'Measuring Guide' %}
                    {%- for popup in sizing_popups -%}
                      {% if popup == 'Measuring Guide' %}
                      <modal-opener class="product-popup-modal__opener no-js-hidden quick-add-hidden" data-modal="#PopupModal-{{ popup | handle }}">
                        <button id="ProductPopup-{{ popup | handle }}" class="product-popup-modal__button link" type="button" aria-haspopup="dialog">{{ popup }}</button>
                      </modal-opener>
                      {% endif %}
                    {%- endfor -%}
                  {% else %}
                    {%- liquid 
                      if block.settings.use_product_description
                        assign content = product.description | split: block.settings.product_description_split_value
                        assign content = content[block.settings.product_description_index]
                        echo content
                      endif 
                    -%}
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  {% endif %}
                </div>
                </details>
              </div>
              {%- assign first_tab = false -%}
            {% endif %}
          {%- when 'quantity_selector' -%}
            <div class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}" {{ block.shopify_attributes }}>
              <label class="form__label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity.label' | t }}
              </label>

              <quantity-input class="quantity">
                <button class="quantity__button no-js-hidden" name="minus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                  {% render 'icon-minus' %}
                </button>
                <input class="quantity__input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="1"
                    value="1"
                    form="{{ product_form_id }}"
                  >
                <button class="quantity__button no-js-hidden" name="plus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                  {% render 'icon-plus' %}
                </button>
              </quantity-input>
            </div>
          {%- when 'popup' -%}
              <modal-opener class="product-popup-modal__opener no-js-hidden quick-add-hidden" data-modal="#PopupModal-{{ block.id }}" {{ block.shopify_attributes }}>
                <button id="ProductPopup-{{ block.id }}" class="product-popup-modal__button link" type="button" aria-haspopup="dialog">{{ block.settings.text | default: block.settings.page.title }}</button>
              </modal-opener>
              <a href="{{ block.settings.page.url }}" class="product-popup-modal__button link no-js">{{ block.settings.text }}</a>
          {%- when 'share' -%}
            <share-button id="Share-{{ section.id }}" class="share-button quick-add-hidden" {{ block.shopify_attributes }}>
              <button class="share-button__button hidden">
                {% render 'icon-share' %}
                {{ block.settings.share_label | escape }}
              </button>
              <details id="Details-{{ block.id }}-{{ section.id }}">
                <summary class="share-button__button">
                  {% render 'icon-share' %}
                  {{ block.settings.share_label | escape }}
                </summary>
                <div id="Product-share-{{ section.id }}" class="share-button__fallback motion-reduce">
                  <div class="field">
                    <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status">
                    </span>
                    <input type="text"
                          class="field__input"
                          id="url"
                          value="{{ product.selected_variant.url | default: product.url | prepend: request.origin }}"
                          placeholder="{{ 'general.share.share_url' | t }}"
                          onclick="this.select();"
                          readonly
                    >
                    <label class="field__label" for="url">{{ 'general.share.share_url' | t }}</label>
                  </div>
                  <button class="share-button__close hidden no-js-hidden">
                    {% render 'icon-close' %}
                    <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
                  </button>
                  <button class="share-button__copy no-js-hidden">
                    {% render 'icon-clipboard' %}
                    <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
                  </button>
                </div>
              </details>
            </share-button>
            <script defer src="{{ 'share.min.js' | asset_url }}"></script>
          {%- when 'similar_product' -%}
            {% if block.settings.similar_product != blank %}
            <div class="button_flex-container">
              <button class="button">
                {% if product.title contains 'Lite' %}
                  Lite Fabric
                {% else %}
                  Signature Fabric
                {% endif %}
              </button>
              <a href="{{ block.settings.similar_product.url }}">
                <button class="button">
                  {% if block.settings.similar_product.title contains 'Lite' %}
                    Lite Fabric
                  {% else %}
                    Signature Fabric
                  {% endif %}
                </button>
              </a>
            </div>
          {% endif %}
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              {%- if block.settings.picker_type == 'button' -%}
                <variant-radios class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <div class="product-form__option" data-option="{{ option.name }}" data-option-index="{{ forloop.index0 }}">
                      <fieldset class="js product-form__input" data-wair-option-name="{{ option.name }}">
                        <div class="size__guide--grid">
                          <legend class="form__label">Select a {{ option.name }}: <span class="current-value">{{ option.selected_value }}</span></legend>
                          {% if option.name == 'Size' %}
                            <div class="product__size-popups">
                              <div class="wair-modal__wrapper">
                                <!-- WAIR PDP CTA -->
                                {% render 'wair' %}
                                {%- for popup in sizing_popups -%}
                                  {% if popup == 'Sizing Guide' %}
                                  <modal-opener class="product-popup-modal__opener no-js-hidden quick-add-hidden" data-modal="#PopupModal-{{ popup | handle }}">
                                    <button id="ProductPopup-{{ popup | handle }}" class="product-popup-modal__button link" type="button" aria-haspopup="dialog">{{ popup }}</button>
                                  </modal-opener>
                                  {% endif %}
                                {%- endfor -%}
                              </div>
                            </div>
                          {% endif %}
                        </div>
                        {%- for value in option.values -%}
                          {%- liquid 
                            if option.name == 'Color'
                              assign swatch_url = value | handle | append: '.jpg' | file_img_url: '80x'
                            endif
                            if value contains 'hide' or value contains 'Hide'
                             continue
                            endif
                          -%}
                          <div class="product-form__radio-wrapper" data-value="{{ value }}">
                            <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                  name="{{ option.name }}"
                                  value="{{ value | escape }}"
                                  form="{{ product_form_id }}"
                                  {% if option.selected_value == value %}checked{% endif %}
                            >
                            <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" {% if option.name == 'Color' %}style="background-image: url({{ swatch_url }});"{% endif %}>
                              <span {% if option.name == 'Color' %}class="visually-hidden"{% endif %}>
                                {% if value == '00' %}
                                  {% assign size = 'XXS' %}
                                {% elsif value == '0' %}
                                  {% assign size = 'XS' %}
                                {% elsif value == '1' %}
                                  {% assign size = 'S' %}
                                {% elsif value == '2' %}
                                  {% assign size = 'M' %}
                                {% elsif value == '3' %}
                                  {% assign size = 'L' %}
                                {% elsif value == '4' %}
                                  {% assign size = 'XL' %}
                                {% elsif value == '5' %}
                                  {% assign size = 'XXL' %}
                                {% elsif value == '6' %}
                                  {% assign size = 'XXXL' %}
                                {% elsif value == '7' %}
                                  {% assign size = 'XXXXL' %}
                                {% endif %}
                                {{ value }} / {{ size }}
                              </span>
                            </label>
                          </div>
                        {%- endfor -%}
                      </fieldset>
                    </div>
                  {%- endfor -%}
                  
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-radios>
              {%- else -%}
                <variant-selects class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
