{% render 'hs-defer-css' with filename: 'alt-article-content.css', pages: 'collection,index,product' | split: ',', local: true %}
{% if section.settings.show_divider %}
<div class="{{ section.id }} alt__article--divider">
    <div class="article-container">
        <div class="section-divider"></div>
    </div>
</div>

<style>
    .{{ section.id }}.alt__article--divider .section-divider {
        width: 100px;
        height: 1px;
        background: #000;
        margin: {{ section.settings.spacing }}px auto;
        display: block;
    }

    .{{ section.id }}.alt__article--divider .article-container {
        margin-bottom: 0;
    }
</style>
{% endif %}

<div class="alt__article--content">
    <div class="article-container">
        {% if section.settings.top_title != blank %}
            <h2>{{ section.settings.top_title }}</h2>
        {% endif %}
        {% if section.settings.sub_text != blank %}
            <div class="article-rte paragraph-{{ section.settings.paragraph_style_1 }}">{{ section.settings.sub_text }}</div>
        {% endif %}
        {% if section.settings.top_sub_title != blank %}
            <h3>{{ section.settings.top_sub_title }}</h3>
        {% endif %}
        {% if section.settings.top_conetnt != blank %}
            <div class="article-rte paragraph-{{ section.settings.paragraph_style_2 }}">{{ section.settings.top_conetnt }}</div>
        {% endif %}
        {% if section.settings.top_quote_title != blank %}
            <div class="pullquote">{{ section.settings.top_quote_title }}</div>
        {% endif %}
        {% if section.settings.top_quote_conetnt != blank %}
            <div class="article-rte paragraph-{{ section.settings.paragraph_style_3 }}">{{ section.settings.top_quote_conetnt }}</div>
        {% endif %}
        {% if section.settings.image != blank %}
            <div class="article-image-block">
                <div class="article-image-full">
                    {%- render 'image',
                    image: section.settings.image,
                    sizes: '(min-width: 768px) 50vw, 100vw',
                    prioritize_loading: true
                    -%}
                </div>
                {% if section.settings.image_caption != blank %}
                <div class="image-caption">{{ section.settings.image_caption }}</div>
                {% endif %}
            </div>
            
        {% endif %}
        {% if section.settings.bottom_title != blank %}
            <h2>{{ section.settings.bottom_title }}</h2>
        {% endif %}
        {% if section.settings.bottom_sub_title != blank %}
            <h3>{{ section.settings.bottom_sub_title }}</h3>
        {% endif %}
        {% if section.settings.bottom_conetnt != blank %}
            <div class="article-rte paragraph-{{ section.settings.paragraph_style_4 }}">{{ section.settings.bottom_conetnt }}</div>
        {% endif %}
        {% if section.settings.bottom_quote_title != blank %}
            <div class="pullquote">{{ section.settings.bottom_quote_title }}</div>
        {% endif %}
        {% if section.settings.bottom_quote_conetnt != blank %}
            <div class="article-rte paragraph-{{ section.settings.paragraph_style_5 }}">{{ section.settings.bottom_quote_conetnt }}</div>
        {% endif %}
        {% if section.settings.bottom_image != blank %}
            <div class="article-image-block">
                <div class="article-image-full">
                    {%- render 'image',
                    image: section.settings.bottom_image,
                    sizes: '(min-width: 768px) 50vw, 100vw',
                    prioritize_loading: true
                    -%}
                </div>
                {% if section.settings.bottom_image_caption != blank %}
                <div class="image-caption">{{ section.settings.bottom_image_caption }}</div>
                {% endif %}
            </div>
            
        {% endif %}
    </div>
</div>

