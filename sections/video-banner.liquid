{% comment %} {%- liquid
  assign pages_to_defer_css = 'collection,index,product' | split: ','
  if section.index == 1
    assign pages_to_defer_css = ''
  endif
-%}
{% render 'hs-defer-css' with filename: 'section-image-banner.css', pages: pages_to_defer_css, local: true %} {% endcomment %}

{%- liquid
  assign video_height_mobile = section.settings.video_height_mobile
  if section.settings.video_height_mobile == 'square'
    assign video_height_mobile = 100
  endif
-%}

{%- style -%}
  {{- 'section-image-banner.css' | inline_asset_content -}}

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before,
    #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
      padding-bottom: {{ video_height_mobile }}%;
      content: '' !important;
      display: block;
    }
  }

  {% if section.settings.button_overlay %}
    @media screen and (max-width: 749px) {
      .banner__media {
        height: 75vh;
      }

      .banner__content {
        top: 33% !important;
        bottom: auto;
      }

      .banner__buttons--mobile {
        position: absolute;
        bottom: 70px;
      }
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before {
      padding-bottom: {{ section.settings.video_height }}%;
      content: '';
      display: block;
    }
  }
{%- endstyle -%}

{%- style -%}
  .video-banner__heading {
    font-family: {{ settings.type_hero_font.family }}, {{ settings.type_hero_font.fallback_families }};
    font-size: 52px;
  }

  .video-banner__text {
    font-size: 22.4px;
  }

  .banner__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 45rem;
    word-break: break-word;
    margin-top: 2rem;
  }

  .video-banner__heading {
    margin-bottom: 0;
  }

  .banner__box > * + * {
    margin-top: 1rem;
  }

  .banner__box > * + .banner__buttons {
    margin-top: 2rem;
  }

  .video-banner__button {
    font-size: 1.5rem;
    text-transform: capitalize;
  }

  .video-banner__button {
    opacity: 1 !important;
    min-width: 220px;
    text-transform: capitalize !important;
  }

  @media screen and (max-width: 749px) {
    .video-banner__button {
      min-width: 100% !important;
    }
  }

  @media screen and (max-width: 749px) {
    .video-banner__text {
      font-size: 14px;
    }

    .video-banner__heading {
      font-size: 40px;
    }
  }

  @media screen and (max-width: 450px) {
    .video-banner__heading {
      font-size: 34px;
    }
  }

  @media screen and (max-width: 749px) {
    .banner__buttons--mobile {
      display: flex;
      flex-direction: column;
      width: 100%;
      justify-content: space-between;
      padding: 0 16px;
      margin-top: 27px;
      gap: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .video-banner .banner__content {
      position: absolute !important;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }

  {% if section.settings.video_overlay_link != blank %}
    @media screen and (max-width: 749px) {
      .banner__video-overlay-link {
        z-index: 3;
      }

      .banner__buttons--mobile {
        z-index: 3;
      }
    }
  {% endif %}
{%- endstyle -%}

<video-banner
  id="Banner-{{ section.id }}"
  class="video-banner banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.adapt_height_first_image and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}"
>
  {% assign video = section.settings.video %}
  {%- if section.settings.video_url != blank or video != blank or section.settings.image != blank -%}
    <div class="small-hide">
      <div class="banner__media media loaded media--{{ section.settings.video_height }}">
        {% assign video_id = section.id | prepend: 'video-desktop--' %}
        {% if section.settings.image != blank %}
          <div class="banner__media media small-hide">
            {%-liquid
              assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio 
              assign sizes = "100vw"
            -%}
            {{ section.settings.image | image_url: width: 1500 | image_tag:
              loading: 'lazy',
              width: section.settings.image.width,
              height: image_height,
              sizes: sizes,
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              alt: section.settings.description | default: section.settings.image.alt
            }}
          </div>
        {% elsif video != blank %}
          {%- render 'video-banner-video',
            video: video,
            video_id: video_id,
            class: 'banner__video',
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            aria_label: section.settings.description,
            is_mobile: false
          -%}
        {% else %}
          <video
            aria-label="{{ section.settings.description }}"
            id="{{ video_id }}"
            class="banner__video"
            preload="metadata"
            aria-hidden="true"
            data-autoplay=""
            muted=""
            loop=""
            playsinline=""
            src="{{ section.settings.video_url }}#t=0.1"
            data-expand="-10"
            width="100%"
          ></video>
        {% endif %}
        {% unless section.settings.image != blank %}
          {% render 'video-controls', id: video_id %}
        {% endunless %}
      </div>
    </div>
  {%- endif -%}
  {% assign video_mobile = section.settings.video_mobile %}
  {% if section.settings.image_mobile != blank %}
    <div class="banner__media media medium-up-hide">
      {%-liquid
        assign image_height_2 = section.settings.image_mobile.width | divided_by: section.settings.image_mobile.aspect_ratio
        assign sizes = "100vw"
      -%}
      {{ section.settings.image_mobile | image_url: width: 600 | image_tag:
        loading: 'lazy',
        width: section.settings.image_mobile.width,
        height: image_height_2,
        sizes: sizes,
        widths: '375, 550',
        alt: section.settings.description | default: section.settings.image_mobile.alt
      }}
    </div>
  {%- elsif section.settings.video_url_mobile != blank or video_mobile != blank -%}
    {% assign video_id = section.id | prepend: 'video-mobile--' %}
    <div class="medium-up-hide banner__media media loaded media--{{ section.settings.video_height_mobile }}">
      {% if section.settings.video_overlay_link != blank -%}
        <a href="{{ section.settings.video_overlay_link }}" class="banner__video-overlay-link"></a>
      {%- endif %}
      {% if video_mobile != blank %}
        {%- render 'video-banner-video',
          video: video_mobile,
          video_id: video_id,
          class: 'banner__video',
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          aria_label: section.settings.description,
          is_mobile: true
        -%}
      {% else %}
        <video
          aria-label="{{ section.settings.description }}"
          id="{{ video_id }}"
          class="banner__video"
          preload="metadata"
          aria-hidden="true"
          data-autoplay=""
          muted=""
          loop=""
          playsinline=""
          src="{{ section.settings.video_url_mobile }}#t=0.1"
          data-expand="-10"
          width="100%"
        ></video>
      {% endif %}
      {% unless section.settings.image != blank %}
        {% render 'video-controls', id: video_id %}
      {% endunless %}
    </div>
  {%- endif -%}

  {% if section.settings.image_overlay != 'none' %}
    <div class="banner__overlay banner__overlay--{{ section.settings.image_overlay }}" style="opacity: {{ section.settings.image_overlay_opacity | times: 1.0 | divided_by: 100 }};"></div>
  {% endif %}
  <div
    class="banner__content video-banner__banner-content banner__content--{{ section.settings.desktop_content_position }} banner__content-mobile--{{ section.settings.mobile_content_position }} page-width"
  >
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }}{% if section.settings.add_text_shadow %} banner__box--shadow{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <{{ block.settings.heading_tag }}
              class="video-banner__heading video-banner__heading--{{ block.id }}"
              {{ block.shopify_attributes }}
              style="color: {{ block.settings.heading_color }}"
            >
              <span>{{ block.settings.heading | escape }}</span>
            </{{ block.settings.heading_tag }}>

            <style>
              .video-banner__heading.video-banner__heading--{{ block.id }} {
                font-size: {{ block.settings.heading_size }}px;
              }
              @media screen and (max-width: 749px) {
                .video-banner__heading.video-banner__heading--{{ block.id }} {
                  font-size: {{ block.settings.heading_size_mobile }}px;
                }
              }
            </style>
          {%- when 'text' -%}
            <div
              class="video-banner__text video-banner__text--{{ block.id }}"
              {{ block.shopify_attributes }}
              style="color: {{ block.settings.text_color }}"
            >
              <span>{{ block.settings.text | escape }}</span>
            </div>

            <style>
              .video-banner__text.video-banner__text--{{ block.id }} {
                font-size: {{ block.settings.text_size }}px;
              }
              @media screen and (max-width: 749px) {
                .video-banner__text.video-banner__text--{{ block.id }} {
                  font-size: {{ block.settings.text_size_mobile }}px;
                }
              }
            </style>
          {%- when 'text-two' -%}
            <div
              class="video-banner__text video-banner__text--{{ block.id }}"
              {{ block.shopify_attributes }}
              style="color: {{ block.settings.text_color }}"
            >
              <span>{{ block.settings.text | escape }}</span>
            </div>

            <style>
              .video-banner__text.video-banner__text--{{ block.id }} {
                font-size: {{ block.settings.text_size }}px;
              }
              @media screen and (max-width: 749px) {
                .video-banner__text.video-banner__text--{{ block.id }} {
                  font-size: {{ block.settings.text_size_mobile }}px;
                }
              }
            </style>
          {%- when 'buttons' -%}
            {%- comment -%} Desktop Banner Buttons {%- endcomment -%}
            <div class="banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button video-banner__button"
                  style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
                >
                  {{ block.settings.button_label_1 | escape }}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button video-banner__button"
                  style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
                >
                  {{ block.settings.button_label_2 | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Mobile Banner Buttons {%- endcomment -%}
  {% comment %} {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'buttons' -%}
        <div class="medium-up-hide banner__buttons--mobile" {{ block.shopify_attributes }}>
          {%- if block.settings.button_label_1 != blank -%}
            <a
              {% if block.settings.button_link_1 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link_1 }}"
              {% endif %}
              class="button video-banner__button"
              style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
            >
              {{ block.settings.button_label_1 | escape }}
            </a>
          {%- endif -%}
          {%- if block.settings.button_label_2 != blank -%}
            <a
              {% if block.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link_2 }}"
              {% endif %}
              class="button video-banner__button"
              style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
            >
              {{ block.settings.button_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%} {% endcomment %}
</video-banner>

{% schema %}
{
  "name": "Video Banner",
  "tag": "section",
  "class": "section section--video-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Banner video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Banner mobile video"
    },
    {
      "type": "url",
      "id": "video_url_mobile",
      "label": "Video URL (mobile)"
    },
    {
      "type": "text",
      "id": "description",
      "label": "SEO and ADA description"
    },
    {
      "type": "checkbox",
      "id": "add_text_shadow",
      "label": "Add Text Shadow"
    },
    {
      "type": "select",
      "id": "image_overlay",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "black",
      "label": "Image Overlay"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "video_height",
      "options": [
        {
          "value": "66.66",
          "label": "Landscape"
        },
        {
          "value": "56.25",
          "label": "16:9"
        }
      ],
      "default": "56.25",
      "label": "Video height"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__9.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.image-banner.settings.desktop_content_position.label"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "t:sections.image-banner.settings.show_text_box.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.image-banner.settings.color_scheme.info"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.header.content"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "options": [
        {
          "value": "top-center",
          "label": "Top"
        },
        {
          "value": "middle-center",
          "label": "Middle"
        },
        {
          "value": "bottom-center",
          "label": "Bottom"
        }
      ],
      "default": "middle-center",
      "label": "Mobile content position"
    },
    {
      "type": "select",
      "id": "video_height_mobile",
      "options": [
        {
          "value": "100",
          "label": "Square"
        },
        {
          "value": "125",
          "label": "Portrait"
        }
      ],
      "default": "100",
      "label": "Video height"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "t:sections.image-banner.settings.show_text_below.label"
    },
    {
      "type": "checkbox",
      "id": "button_overlay",
      "label": "Mobile buttons overlay"
    },
    {
      "type": "url",
      "id": "video_overlay_link",
      "label": "(Optional) Hero video overlay link"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Header Color"
        },
        {
          "type": "number",
          "id": "heading_size",
          "default": 52,
          "label": "Heading Size (px)"
        },
        {
          "type": "number",
          "id": "heading_size_mobile",
          "default": 34,
          "label": "Heading Size Mobile (px)"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            }
          ],
          "default": "h2",
          "label": "Heading tag"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-banner.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color"
        },
        {
          "type": "number",
          "id": "text_size",
          "default": 22,
          "label": "Text Size (px)"
        },
        {
          "type": "number",
          "id": "text_size_mobile",
          "default": 14,
          "label": "Text Size Mobile (px)"
        }
      ]
    },
    {
      "type": "text-two",
      "name": "Text Two",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color"
        },
        {
          "type": "number",
          "id": "text_size",
          "default": 22,
          "label": "Text Size (px)"
        },
        {
          "type": "number",
          "id": "text_size_mobile",
          "default": 14,
          "label": "Text Size Mobile (px)"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.image-banner.blocks.buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Button label",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_label_1.label",
          "info": "t:sections.image-banner.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_link_1.label"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Background Color"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Text Color"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Button label",
          "label": "Second button label",
          "info": "Leave the label blank to hide the button"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
