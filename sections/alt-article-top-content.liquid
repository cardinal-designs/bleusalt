{% render 'hs-defer-css' with filename: 'alt-article-top-content.css', pages: 'collection,index,product' | split: ',', local: true %}

<div class="alt__article--top-content">
    <div class="article-container">
        {% if section.settings.category != blank %}
            <div class="category-label">{{ section.settings.category }}</div>
        {% endif %}
        <h1>{{ article.title }}</h1>
        {% if section.settings.subtitle != blank %}
            <div class="subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}
        {% if section.settings.byline != blank %}
            <div class="byline">{{ section.settings.byline }}</div>
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "Article Title Section",
    "settings": [
        {
            "type": "richtext",
            "id": "top_conetnt",
            "label": "Top Content"
        },
        {
            "type": "text",
            "id": "top_quote_title",
            "label": "Top quote title"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "bottom_title",
            "label": "Bottom title"
        },
        {
            "type": "richtext",
            "id": "bottom_conetnt",
            "label": "Bottom content"
        },
        {
            "type": "text",
            "id": "bottom_quote_title",
            "label": "Bottom quote title"
        },
        {
            "type": "richtext",
            "id": "bottom_quote_conetnt",
            "label": "Bottom quote content"
        },
    ]
}
{% endschema %}