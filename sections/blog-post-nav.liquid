{% render 'hs-defer-css' with filename: 'blog-post-nav.css', pages: 'collection,index,product' | split: ',', local: true %}

{% if article %}

  {% assign articles = blog.articles %}
  {% assign current_index = 0 %}

  {% for a in articles %}
    {% if a.id == article.id %}
    {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}

  {% assign prev_index = current_index | minus: 1 %}
  {% assign next_index = current_index | plus: 1 %}

  {% assign prev_article = articles[prev_index] %}
  {% assign next_article = articles[next_index] %}

  <div class="blog-post-nav">
    <div class="">
        <div class="blog-post-nav__item blog-post-nav__prev">
        {% if prev_article %}
            <a href="{{ prev_article.url }}" class="nav-link">
            <span class="nav-arrow">←</span>
            <span class="nav-text">Previous</span>

            <div class="nav-preview">
                {% if prev_article.image %}
                <img src="{{ prev_article.image | image_url: width: 200 }}" alt="{{ prev_article.title }}">
                {% endif %}
                <p>{{ prev_article.title }}</p>
            </div>
            </a>
        {% endif %}
        </div>
        <div class="blog-post-nav__center">
        <a href="{{ blog.url }}" class="back-link">
            Back to The Edit
        </a>
        </div>
        <div class="blog-post-nav__item blog-post-nav__next">
        {% if next_article %}
            <a href="{{ next_article.url }}" class="nav-link">
            <span class="nav-text">Next</span>
            <span class="nav-arrow">→</span>

            <div class="nav-preview">
                {% if next_article.image %}
                <img src="{{ next_article.image | image_url: width: 200 }}" alt="{{ next_article.title }}">
                {% endif %}
                <p>{{ next_article.title }}</p>
            </div>
            </a>
        {% endif %}
        </div>
    </div>
  </div>

{% endif %}


{% schema %}
{
    "name": "Blog Post Naviagtion",
    "tag": "section",
}
{% endschema %}