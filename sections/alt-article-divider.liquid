<div class="{{ section.id }} alt__article--divider">
    <div class="article-container">
        <div class="section-divider"></div>
    </div>
</div>

<style>
    .{{ section.id }}.alt__article--divider .section-divider {
        width: 100px;
        height: 1px;
        background: #000;
        margin: {{ section.settings.spacing }}px auto;
        display: block;
    }
</style>

{% schema %}
{
    "name": "Article Divider",
    "settings": [
        {
            "type": "range",
            "id": "spacing",
            "label": "Spacing",
            "min": 10,
            "max": 100,
            "step": 5,
            "default": 50
        }
    ],
    "presets": [
        {
            "name": "Article Divider"
        }
    ]
}
{% endschema %}