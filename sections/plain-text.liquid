<div class="plain-text page-width">
  {%- if section.settings.content != blank -%}
    <p class="plain-text__content">{{ section.settings.content }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Plain Text",
  "tag": "section",
  "class": "section section--plain-text",
  "settings": [
    {
      "type": "text",
      "id": "content",
      "label": "Text"
    }
  ],

  "presets": [
    {
      "name": "Plain Text"
    }
  ]
}
{% endschema %}
