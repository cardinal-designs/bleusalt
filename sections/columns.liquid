{%- style -%}
  {{- 'section-columns.css' | inline_asset_content -}}
{%- endstyle -%}

<div class="columns">
  <div class="{% if section.settings.add_padding %}page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
  {
    "name": "Columns",
    "settings": [
      {
        "type": "checkbox",
        "id": "add_padding",
        "label": "Add Padding"
      },
      {
        "type": "select",
        "id": "media_ratio",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ],
        "default": "square",
        "label": "Media Ratio"
      }
    ],
    "blocks": [{ "type": "_column" }],
    "presets": [
      {
        "name": "Columns"
      }
    ]
  }
{% endschema %}