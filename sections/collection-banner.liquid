<link rel="stylesheet" href="{{ 'collection-banner.css' | asset_url }}">

<div class="collection-banner">
  <div class="collection-banner__container">
    {% for block in section.blocks %}
      {% assign current_collection = collections[block.settings.collection] %}
      <a class="collection-banner__item" {{ block.shopify_attributes }}>
        <div class="collection-banner__item-image">
          {{ current_collection.image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            width: current_collection.image.width,
            sizes: '375px',
            widths: '375, 550',
            alt: current_collection.title | escape
          }}
        </div>
        <p class="collection-banner__item-title">{{ current_collection.title }}</p>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Banner Mobile",
  "settings": [

  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banner Mobile"
    }
  ]
}
{% endschema %}
