{% comment %}
    Renders a product card

    Accepts:
    - card_product: {Object} Product Liquid object (optional)
    - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
    - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
    - show_vendor: {Boolean} Show the product vendor. Default: false
    - show_rating: {Boolean} Show the product rating. Default: false
    - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
    - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
    - show_quick_add: {Boolean} Show the quick add button.
    - section_id: {String} The ID of the section that contains this card.
    - hasHover_image: {Boolean} Show 2nd image on hover.

    Usage:
    {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{% render 'hs-defer-css' with filename: 'component-rating.css', pages: 'collection,index,product' | split: ',', local: true %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == nil
      assign ratio = 1
    endif
    assign selected_color = false
    if card_product.options contains 'Color'
      assign selected_color = card_product.options_by_name['Color'].selected_value
    endif

    assign badges = ''
    for tag in card_product.tags 
      if tag contains 'badge:'
        if badges == ''
          assign badges = tag | split: ':' | last
        else
          assign badges = badges | append: ',' | append: tag | split: ':' | last
        endif
      endif
    endfor

    assign video = false

    for media in card_product.media
      if media.media_type == 'video'
        assign video = media
      endif
    endfor
  -%}
  <div class="card-wrapper underline-links-hover">
    <div class="card
      card--{{ settings.card_style }}
      card-product
      {% if card_product.featured_media %} card--media{% else %} card--text{% endif %}
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}"
      data-id="{{ card_product.id }}"
      data-title="{{ card_product.title }}"
      data-json='{{ card_product | json | escape }}'
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_product.featured_media or settings.card_style == 'standard' %} ratio{% endif %}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">

        {%- if card_product.featured_media -%}
          <div class="card__media">
            <div class="media media--transparent media--hover-effect">
              {%- assign main_image = card_product.featured_media -%}

              {% if show_life_image %}
              {%- for media in card_product.media -%}
                {% if media.media_type == 'image' %}
                  {%- if media.alt and media.alt contains 'All | ' -%}
                    {%- assign main_image = media -%}
                    {%- break -%}
                  {%- endif -%}
                {% endif %}
              {%- endfor -%}
              {% endif %}
        
              <img
                srcset="{%- if main_image.width >= 165 -%}{{ main_image | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if main_image.width >= 360 -%}{{ main_image | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if main_image.width >= 533 -%}{{ main_image | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if main_image.width >= 720 -%}{{ main_image | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if main_image.width >= 940 -%}{{ main_image | image_url: width: 940 }} 940w,{%- endif -%}
                  {%- if main_image.width >= 1066 -%}{{ main_image | image_url: width: 1066 }} 1066w,{%- endif -%}
                  {{ main_image | image_url }} {{ main_image.width }}w"
                src="{{ main_image | image_url: width: 533 }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                alt="{{ main_image.alt | escape }}"
                class="motion-reduce"
                {% unless lazy_load == false %}loading="lazy"{% endunless %}
                width="{{ main_image.width }}"
                height="{{ main_image.height }}"
              >

              {%- assign hover_image = null -%}
              {%- assign default_variant = card_product.variants.first -%}
              {%- if default_variant and default_variant.option1 -%}
                {%- assign color_name = default_variant.option1 -%}
                {%- for media in card_product.media -%}
                  {%- if media.alt and media.alt contains color_name -%}
                    {%- assign hover_image = media -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {% assign matching_image = false %}
              {% if main_image == hover_image %}
                {% assign matching_image = true %}
                {%- assign hover_image = card_product.media[1] -%}
              {% endif %}

              {% if hover_image != blank and show_secondary_image %}
              <div class="card__hover-image-1 card__hover-image media media--transparent" {% if matching_image %} data-hover-image="{{ hover_image }}"{% endif %} {% if force_load %}style="opacity: 1;"{% endif %}>
                <img
                  srcset="{%- if hover_image -%}
                    {%- if hover_image.width >= 165 -%}{{ hover_image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if hover_image.width >= 360 -%}{{ hover_image | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if hover_image.width >= 533 -%}{{ hover_image | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if hover_image.width >= 720 -%}{{ hover_image | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if hover_image.width >= 940 -%}{{ hover_image | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if hover_image.width >= 1066 -%}{{ hover_image | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ hover_image | image_url }} {{ hover_image.width }}w
                  {%- else -%}
                    {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                  {%- endif -%}
                  "
                  src="{% if hover_image %}{{ hover_image | image_url: width: 533 }}{% else %}{{ card_product.media[1] | image_url: width: 533 }}{% endif %}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{% if hover_image %}{{ hover_image.alt }}{% else %}{{ card_product.media[1].alt }}{% endif %}"
                  class="motion-reduce"
                  loading="lazy"
                  width="{% if hover_image %}{{ hover_image.width }}{% else %}{{ card_product.media[1].width }}{% endif %}"
                  height="{% if hover_image %}{{ hover_image.height }}{% else %}{{ card_product.media[1].height }}{% endif %}"
                >
              </div>
              {% endif %}
              
            </div>
          </div>
        {%- endif -%}
        
        <div class="card__content">
          <div class="card__information">
            <h2 class="card__heading"{% if card_product.featured_media == nil and settings.card_style == 'standard' %} id="title-{{ section_id }}-{{ card_product.id }}"{% endif %}>
              <a href="{{ card_product.url }}" data-product-url="{{ card_product.url }}" id="StandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}" class="full-unstyled-link">
                {{ card_product.title | escape }}
              </a>
            </h2>
          </div>
          
          {% comment %} <div class="card__badge {{ settings.badge_position }}">
            {%- if card_product.available == false -%}
              <span id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
            {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
              <span id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
            {%- endif -%}
          </div> {% endcomment %}
         
          {% assign vendor_handle = card_product.vendor | handleize %}
          {% if vendor_handle == 'couture' %}
            <a href="mailto:inquire@bleusalt.com" class="inquires__btn button--inline">Inquires only</a>
          {% endif %}
          
          {% unless vendor_handle == 'couture' %}
            {% if show_quick_add %}
              {% render 'quick-add', product: card_product %}
            {% endif %}
          {% endunless %}
        </div>
      </div>
      <div class="card__content card__content-custom">
        <div class="card__information">
          <div class="flex space-between">
            <a data-product-url="{{ card_product.url }}" href="{{ card_product.url }}" class="full-unstyled-link">
              <h2 class="card__heading{% if card_product.featured_media or settings.card_style == 'standard' %} h4{% endif %}"{% if card_product.featured_media or settings.card_style == 'card' %} id="title-{{ section_id }}-{{ card_product.id }}"{% endif %}>
                  {{ card_product.title | escape }}
                {% comment %} <a data-product-url="{{ card_product.url }}" href="{{ card_product.url }}" id="CardLink-{{ section_id }}-{{ card_product.id }}" class="full-unstyled-link">
                  {{ card_product.title | escape }}
                </a> {% endcomment %}
              </h2>
            </a>
            {% assign vendor_handle = card_product.vendor | handleize %}
            
            {% unless vendor_handle == 'couture' %}
              {% render 'price', product: card_product, price_class: '' %}
            {% endunless %}
          </div>
          <div class="card-information">
            {% assign category = card_product.metafields.custom.product_grid_description.value %}
            {% if category != blank %}
              <span class="caption-with-letter-spacing--large product__category">
                <a href="{{ category.url }}" class="full-unstyled-link">
                  {{ category.title }}
                </a>
              </span>
            {% endif %}
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}

            <span class="caption-large light">{{ block.settings.description | escape }}</span>
            {% if selected_color %}
            <span class="h4 card__selected-color">{{ selected_color }}</span>
            {% endif %}
            
          </div>

          {% unless vendor_handle == 'couture' %}
            {%- if show_quick_add -%}
              {% assign total_colors = card_product.options_by_name['Color'].values.size %}
              {% assign max_colors = 5 %}
              
              <div class="quick-add__colors">
            {% assign hide_me = false %}
            {% for value in card_product.options_by_name['Color'].values %}
              {%- liquid 
                if forloop.index > max_colors
                  assign hide_me = true
                endif
                if value contains 'hide' or value contains 'Hide'
                  assign hide_me = true
                endif 
              -%}
              {% assign swatch_url = value | handle | append: '.jpg' | file_img_url: '80x' %}
              <button
                data-index="{{ forloop.index }}"
                aria-label="color, {{ value }}"
                {% if forloop.first %}selected{% endif %} 
                type="button" value="{{ value }}" 
                class="quick-add__button quick-add__button--color button--inline" 
                style="background-image: url({{ swatch_url }});{% if hide_me %}display: none;{% endif %}"
              >
                <span class='visually-hidden'>{{ value }}</span>
              </button>
            {% endfor %}
            
            {% if total_colors > max_colors %}
              <a href="{{ card_product.url }}" class="link">+ {{ total_colors | minus: max_colors }} more <span class="visuallyhideen">color of the {{ card_product.title | escape }}</span></a>
            {% endif %}
            </div>
            {%- endif -%}
          {% endunless %}

          {% unless template.name == 'search' %}
            {% comment %}
            {% render 'okendo-reviews-product-rating-summary', product: card_product %}
            {% endcomment %}
            <div class="klaviyo-star-rating-widget small-hide" data-id="{{card_product.id}}" data-product-title="{{card_product.title}}" data-product-type="{{card_product.type}}"></div>
          {% endunless %}
        </div>

        {% comment %} <div class="card__badge {{ settings.badge_position }}"> {% endcomment %}
        <div class="card__badge">
          {%- if card_product.available == false -%}
              {%- if settings.show_sold_out -%}
                <span id="Badge-{{ section_id }}-{{ card_product.id }}" class="badge badge--sold-out color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
              {%- endif -%}
            {%- if badges != '' -%}
              {%- for badge in badges -%}
                <span id="Badge-{{ section_id }}-{{ card_product.id }}--{{ badge | handle }}" class="badge badge--{{ badge | handle }}">{{ badge }}</span>
              {%- endfor -%}
            {%- endif -%}
          {%- elsif badges != '' -%}
            {%- for badge in badges -%}
              <span id="Badge-{{ section_id }}-{{ card_product.id }}--{{ badge | handle }}" class="badge badge--{{ badge | handle }}">{{ badge }}</span>
            {%- endfor -%}
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}            
            <span id="Badge-{{ section_id }}-{{ card_product.id }}" class="badge badge--sale color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
          {%- endif -%}  
        </div>
       
  
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper underline-links-hover">
    <div class="card
      card--{{ settings.card_style }}
      card--text
      {% if extend_height %} card--extend-height{% endif %}
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}"
      style="--ratio-percent: 100%;"
    >
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if settings.card_style == 'standard' %} ratio{% endif %}" style="--ratio-percent: 100%;">
        <div class="card__content">
          <div class="card__information">
            <h2 class="card__heading">
              <a role="link" aria-disabled="true" class="full-unstyled-link">
                {{ 'onboarding.product_title' | t }}
              </a>
            </h2>
          </div>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information">
          <h2 class="card__heading{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h2>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price' %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
