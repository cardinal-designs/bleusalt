<script>
  (() => {
    const scriptsToDefer = ['b5303c62bw494ab25dp0d72f2dcm48e21f5am.js', '/gtag/js', 'gtm.js'];

    const originalAppendChild = document.head.appendChild;

    document.head.appendChild = function (element) {
      if (element.tagName === 'SCRIPT') {
        const src = element.getAttribute('src') || '';

        for (const scriptName of scriptsToDefer) {
          if (src.includes(scriptName)) {
            element.dataset.lazySrc = src;
            element.removeAttribute('src');
            break;
          }
        }
      }

      originalAppendChild.call(document.head, element);
    };
  })();
</script>
