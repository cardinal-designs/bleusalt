{%- liquid
  if image_ratio == 'square'
    assign ratio = 100
  elsif image_ratio == 'portrait'
    assign ratio = 125
  elsif image_ratio != blank
    assign ratio = image_ratio
  else
    assign ratio = 1 | divided_by: image.aspect_ratio | times: 100
  endif
-%}
<div style="padding-top:{{ ratio }}%;" class="media {% if class != blank %}{{ class }}{% endif %}{% if zoom %} swiper-zoom-container{% endif %}">
  {%- liquid
    assign loading = 'lazy'
    assign fetchpriority = 'auto'
    assign preload = false
    if prioritize_loading == true
      assign loading = 'eager'
      assign fetchpriority = 'high'
      assign preload = true
    endif

    assign data_alt = image.alt | escape | split: ' | ' | first
  -%}
  {{-
    image
    | image_url: width: image.width
    | image_tag:
      sizes: '(min-width: 1200px) calc((1200px - 10rem) / 2), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw - 4rem)',
      widths: '300,576,550,1100,1600,2048,2560,3840',
      loading: loading,
      fetchpriority: fetchpriority,
      preload: preload,
      data-alt: data_alt
  -}}
</div>
