<div class="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    {% for tag in product.tags %}
      {% assign specificTag = tag | downcase %}

      {% comment %}
      {% case specificTag %}
        {% when "womens tops" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "mens tops" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "womens bottoms" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "mens-bottoms" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "dresses" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "womens-accessories", "mens-accessories" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">Unisex</a></li>
        {% when "womens-accessories" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
        {% when "mens-accessories" %}
          <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% endcase %}
      {% endcomment %}
      
      {% if specificTag == "womens tops" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "mens tops" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "womens bottoms" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "mens-bottoms" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "dresses" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "womens-accessories" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% elsif specificTag == "mens-accessories" %}
        <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% endif %}
      
      
      {% comment %}
      <li><a href="/collections/all?constraint={{ tag | handleize }}">{{ specificTag }}</a></li>
      {% endcomment %}
    {% endfor %}
    <li>{{ product.title }}</li>
  </ul>
</div>