<{{ block.settings.heading_tag }}
  class="title-block title-block--{{ block.id }}"
  {{ block.shopify_attributes }}
  style="color: {{ block.settings.color }}"
>
  <span>{{ block.settings.heading | escape }}</span>
</{{ block.settings.heading_tag }}>

<style>
  .title-block.title-block--{{ block.id }} {
    font-size: {{ block.settings.font_size }}px;
  }
  @media screen and (max-width: 749px) {
    .title-block.title-block--{{ block.id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
</style>

{% schema %}
  {
    "name": "Title",
    "settings": [
      {
        "type": "inline_richtext",
        "id": "heading",
        "default": "Lorem Ipsum",
        "label": "Heading"
      },
      {
        "type": "color",
        "id": "color",
        "label": "Color",
        "default": "#FFFFFF"
      },
      {
        "type": "number",
        "id": "font_size",
        "default": 52,
        "label": "Font Size (px)"
      },
      {
        "type": "number",
        "id": "font_size_mobile",
        "default": 34,
        "label": "Font Size Mobile (px)"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          }
        ],
        "default": "h2",
        "label": "Heading tag"
      }
    ],
    "presets": [
      {
        "name": "Title"
      }
    ]
  }
{% endschema %}